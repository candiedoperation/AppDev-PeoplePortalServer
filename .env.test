# Test-environment stubs. Committed on purpose: these are placeholders, not
# secrets, and tests must be reproducible on a clean checkout.
#
# They exist because importing almost any module transitively loads config.ts,
# which constructs every shared-resource client at import time and those
# constructors demand their variables. Until construction is made lazy, a unit
# test cannot import a module without them.

NODE_ENV=test

PEOPLEPORTAL_BASE_URL=http://localhost:3000
PEOPLEPORTAL_WEBHOOK_URL=http://localhost:3000
PEOPLEPORTAL_MONGO_URL=mongodb://localhost:27017/people-portal-test
PEOPLEPORTAL_TOKEN_SECRET=test-token-secret-not-used-outside-tests
PEOPLEPORTAL_REDIS_URL=redis://localhost:6379

PEOPLEPORTAL_AUTHENTIK_ENDPOINT=http://localhost:9000
PEOPLEPORTAL_AUTHENTIK_TOKEN=test-authentik-token
PEOPLEPORTAL_OIDC_DSCVURL=http://localhost:9000/application/o/people-portal/.well-known/openid-configuration
PEOPLEPORTAL_OIDC_CLIENTID=test-client-id
PEOPLEPORTAL_OIDC_CLIENTSECRET=test-client-secret

PEOPLEPORTAL_GITEA_ENDPOINT=http://localhost:10000
PEOPLEPORTAL_GITEA_TOKEN=test-gitea-token
PEOPLEPORTAL_GITEA_WEBHOOK_SECRET=test-gitea-webhook-secret-at-least-32-chars

PEOPLEPORTAL_SLACK_BOT_TOKEN=xoxb-test
PEOPLEPORTAL_SLACK_ACCESSTOKEN=xoxb-test
PEOPLEPORTAL_SLACK_INVITE_URL=https://example.invalid/slack

PEOPLEPORTAL_DISCORD_BOT_TOKEN=test-discord-token
PEOPLEPORTAL_DISCORD_SERVER_ID=000000000000000000

PEOPLEPORTAL_SMTP_HOST=localhost
PEOPLEPORTAL_SMTP_PORT=1025
PEOPLEPORTAL_SMTP_SECURE=false
PEOPLEPORTAL_SMTP_USER=test@localhost
PEOPLEPORTAL_SMTP_PASS=test

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ORG_ROOT_ID=r-test
AWS_NONPROD_OU_ID=ou-test
AWS_MANAGEMENT_ACCOUNT_ID=000000000000
AWS_ADMIN_ROLE_NAME=OrganizationAccountAccessRole
AWS_DEFAULT_BUDGET_AMOUNT=20
AWS_BILLING_ALERT_EMAIL=test@localhost
S3_BUCKET_NAME=people-portal-test

PHOTO_CHECK_URL=http://localhost:8001
